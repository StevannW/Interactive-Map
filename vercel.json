{
  "version": 2,
  "framework": "laravel",
  "functions": {
    "api/index.php": {
      "runtime": "php:8.3"
    }
  },
  "routes": [
    {
      "src": "/(.+?)/?$",
      "dest": "/api/index.php"
    },
    {
      "src": "/api/(.+?)/?$",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "composer install --no-dev && npm install && npm run build"
}